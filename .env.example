# Copy the values you need into your host's environment settings.
# None of these are required for local development except DJANGO_DEBUG=True.

# Required in production: a long random string
DJANGO_SECRET_KEY=

# True for local development, False (or unset) in production
DJANGO_DEBUG=True

# Comma-separated hostnames the site is served from (Render's own hostname is added automatically)
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Only needed when running the React dev server (npm start) against Django
DJANGO_CORS_ALLOWED_ORIGINS=http://localhost:3000

# Postgres connection string; leave empty to use local SQLite
DATABASE_URL=

# Set to True to require an admin to activate new accounts
SIGNUP_REQUIRES_APPROVAL=False

# Used by build.sh to create the admin account on first deploy
DJANGO_SUPERUSER_USERNAME=
DJANGO_SUPERUSER_EMAIL=
DJANGO_SUPERUSER_PASSWORD=

# Imgur client ID for profile picture uploads
IMGUR_CLIENT_ID=
